{
	"info": {
		"name": "Microservicios Auth y Bitácora - CUC",
		"description": "Endpoints para Login, Tokens y Auditoría",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Autenticación (SRV1)",
			"item": [
				{
					"name": "Login Administrador",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"usuario\": \"rodrigo_actualizado@correo.com\",\n  \"contrasena\": \"123456\",\n  \"tipousuario\": \"Admin\"\n}"
						},
						"url": {
							"raw": "https://localhost:7123/login",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "7123",
							"path": [
								"login"
							]
						}
					}
				},
				{
					"name": "Validar Token",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer PEGA_TU_ACCESS_TOKEN_AQUI"
							}
						],
						"url": {
							"raw": "https://localhost:7123/validate",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "7123",
							"path": [
								"validate"
							]
						}
					}
				},
				{
					"name": "Refrescar Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"PEGA_TU_REFRESH_TOKEN_AQUI\"\n}"
						},
						"url": {
							"raw": "https://localhost:7123/refresh",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "7123",
							"path": [
								"refresh"
							]
						}
					}
				},
				{
					"name": "Crear Nuevo Usuario Auth",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"Email\": \"nuevo.estudiante@cuc.cr\",\n  \"Password\": \"ClaveSegura123\",\n  \"UserType\": \"Estudiante\"\n}"
						},
						"url": {
							"raw": "https://localhost:7123/create-user",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "7123",
							"path": [
								"create-user"
							]
						}
					}
				}
			]
		},
		{
			"name": "2. Bitácora de Auditoría (SRV9)",
			"item": [
				{
					"name": "Registrar en Bitácora",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer PEGA_TU_ACCESS_TOKEN_AQUI"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"UsuarioId\": 1,\n  \"Descripcion\": \"El administrador ingresó al sistema ERP para consultar matrículas.\"\n}"
						},
						"url": {
							"raw": "https://localhost:7123/bitacora",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "7123",
							"path": [
								"bitacora"
							]
						}
					}
				},
				{
					"name": "Consultar Bitácora",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer PEGA_TU_ACCESS_TOKEN_AQUI"
							}
						],
						"url": {
							"raw": "https://localhost:7123/bitacora",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "7123",
							"path": [
								"bitacora"
							]
						}
					}
				}
			]
		}
	]
}