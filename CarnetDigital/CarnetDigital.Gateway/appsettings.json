{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/gateway/auth/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/auth" }
        ]
      },
      "usuarios-route": {
        "ClusterId": "usuario-cluster",
        "Match": { "Path": "/gateway/usuarios/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/usuarios" },
          { "PathPrefix": "/api/usuario" }
        ]
      },
      "roles-route": {
        "ClusterId": "accesscontrol-cluster",
        "Match": { "Path": "/gateway/roles/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/roles" },
          { "PathPrefix": "/rol" }
        ]
      },
      "pantallas-route": {
        "ClusterId": "accesscontrol-cluster",
        "Match": { "Path": "/gateway/pantallas/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/pantallas" },
          { "PathPrefix": "/pantallas" }
        ]
      },
      "bitacora-route": {
        "ClusterId": "audit-cluster",
        "Match": { "Path": "/gateway/bitacora/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/bitacora" },
          { "PathPrefix": "/bitacora" }
        ]
      },
      "areas-route": {
        "ClusterId": "areas-cluster",
        "Match": { "Path": "/gateway/areas/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/areas" },
          { "PathPrefix": "/api/Areas" }
        ]
      },
      "carreras-route": {
        "ClusterId": "carreras-cluster",
        "Match": { "Path": "/gateway/carreras/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/carreras" },
          { "PathPrefix": "/api/Carreras" }
        ]
      },
      "instituciones-route": {
        "ClusterId": "instituciones-cluster",
        "Match": { "Path": "/gateway/instituciones/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/instituciones" },
          { "PathPrefix": "/api/Instituciones" }
        ]
      },
      "tipos-identificacion-route": {
        "ClusterId": "tipos-identificacion-cluster",
        "Match": { "Path": "/gateway/tipos-identificacion/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/tipos-identificacion" },
          { "PathPrefix": "/api/TiposIdentificacion" }
        ]
      },
      "tipos-usuario-route": {
        "ClusterId": "tipos-usuario-cluster",
        "Match": { "Path": "/gateway/tipos-usuario/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/tipos-usuario" },
          { "PathPrefix": "/api/TiposUsuario" }
        ]
      },
      "parametros-route": {
        "ClusterId": "parametro-cluster",
        "Match": { "Path": "/gateway/parametros/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/parametros" },
          { "PathPrefix": "/parametro" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://localhost:7181/" }
        }
      },
      "usuario-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://localhost:7035/" }
        }
      },
      "accesscontrol-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://localhost:7064/" }
        }
      },
      "audit-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://localhost:7290/" }
        }
      },
      "areas-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://localhost:7303/" }
        }
      },
      "carreras-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://localhost:7302/" }
        }
      },
      "instituciones-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://localhost:7301/" }
        }
      },
      "tipos-identificacion-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://localhost:7305/" }
        }
      },
      "tipos-usuario-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://localhost:7304/" }
        }
      },
      "parametro-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://localhost:7238/" }
        }
      }
    }
  }
}
