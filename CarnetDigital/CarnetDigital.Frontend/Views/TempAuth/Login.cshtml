@* TEMPORAL - reemplazar con Web1 *@
@model CarnetDigital.Frontend.Models.TempAuth.LoginFormViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<h1>Iniciar sesión</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-controller="TempAuth" asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Usuario" class="control-label"></label>
                <input asp-for="Usuario" class="form-control" autocomplete="username" />
                <span asp-validation-for="Usuario" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Contrasena" class="control-label"></label>
                <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Contrasena" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TipoUsuario" class="control-label"></label>
                <input asp-for="TipoUsuario" class="form-control" />
                <span asp-validation-for="TipoUsuario" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Ingresar</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
