@model CarnetDigital.Frontend.Models.Usuarios.UsuarioDTO

<h1 class="h4 mb-4">Editar Usuario</h1>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md-5">
                <form asp-action="Editar" method="post">

                    <input type="hidden" asp-for="RolId" />
                    <input type="hidden" asp-for="TipoUsuarioId" />
                    <input type="hidden" asp-for="TipoIdentificacionId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Número de Identificación</label>
                        <input asp-for="Identificacion" class="form-control bg-light" readonly />
                        <small class="text-muted">La identificación no se puede modificar.</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NombreCompleto" class="form-label fw-bold">Nombre Completo</label>
                        <input asp-for="NombreCompleto" class="form-control" required />
                        <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Correo Electrónico</label>
                        <input asp-for="Email" type="email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                        <a asp-action="WEB16" class="btn btn-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
