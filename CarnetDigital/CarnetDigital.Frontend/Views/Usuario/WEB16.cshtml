@model IEnumerable<CarnetDigital.Frontend.Models.Usuarios.UsuarioDTO>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h4 mb-0">Gestión y Listado de Usuarios</h1>
            <a asp-action="WEB4" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Nuevo
            </a>
        </div>

        <form method="get" asp-action="WEB16" class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">Identificación</label>
                <input type="text" name="identificacion" class="form-control" value="@ViewBag.FiltroIdentificacion" placeholder="Buscar por cédula..." />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Nombre</label>
                <input type="text" name="nombre" class="form-control" value="@ViewBag.FiltroNombre" placeholder="Buscar por nombre..." />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Tipo de Usuario ID</label>
                <input type="number" name="tipoUsuarioId" class="form-control" value="@ViewBag.FiltroTipo" placeholder="Ej. 1 o 2" />
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                <a asp-action="WEB16" class="btn btn-outline-secondary w-100">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Identificación</th>
                        <th>Nombre Completo</th>
                        <th>Correo Electrónico</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td><strong>@usuario.Identificacion</strong></td>
                                <td>@usuario.NombreCompleto</td>
                                <td>@usuario.Email</td>
                                <td class="text-end">
                                    <a asp-action="WEB9" asp-route-id="@usuario.Identificacion" class="btn btn-icon btn-info text-white" title="Ver Detalle">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a asp-action="Editar" asp-route-id="@usuario.Identificacion" class="btn btn-icon btn-primary" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <button type="button" class="btn btn-icon btn-danger" onclick="confirmarEliminacion('@usuario.Identificacion', '@usuario.NombreCompleto')" title="Eliminar">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-secondary" onclick="abrirModalEstado('@usuario.Identificacion', '@usuario.NombreCompleto')" title="Cambiar estado">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">No se encontraron usuarios con los filtros aplicados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<form id="formEliminar" asp-action="Eliminar" method="post" style="display:none;">
    <input type="hidden" name="id" id="usuarioIdEliminar" />
</form>

<!-- Modal para Cambiar Estado -->
<div class="modal fade" id="modalCambiarEstado" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title">Cambiar Estado de Usuario</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CambiarEstado" method="post">
                <div class="modal-body">
                    <p>Selecciona el nuevo estado para el usuario <strong id="nombreUsuarioEstado"></strong>:</p>

                    <!-- ID oculto que viaja al controlador -->
                    <input type="hidden" name="identificacion" id="identificacionEstado" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nuevo Estado</label>
                        <select name="estadoId" class="form-select" required>
                            <option value="">Seleccione un estado...</option>

                            <option value="1">Activo</option>
                            <option value="2">Inactivo</option>
                            <option value="3">Pendiente</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Cambio</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Función para pasar los datos al modal y mostrarlo
        function abrirModalEstado(identificacion, nombre) {
            document.getElementById('identificacionEstado').value = identificacion;
            document.getElementById('nombreUsuarioEstado').innerText = nombre;

            var modal = new bootstrap.Modal(document.getElementById('modalCambiarEstado'));
            modal.show();
        }
</script>

<script>
    function confirmarEliminacion(id, nombre) {
        if (confirm(`¿Estás seguro de que deseas eliminar permanentemente al usuario "${nombre}" (${id})?`)) {
            document.getElementById('usuarioIdEliminar').value = id;
            document.getElementById('formEliminar').submit();
        }
    }
</script>
