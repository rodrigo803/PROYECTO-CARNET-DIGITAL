@model CarnetDigital.Frontend.Models.Usuarios.UsuarioDTO

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 mb-0">Perfil de Usuario</h1>
    <span class="badge bg-secondary fs-6">ID: @Model.Identificacion</span>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="text-muted fw-bold">Nombre Completo:</label>
                <p class="fs-5">@Model.NombreCompleto</p>
            </div>
            <div class="col-md-6">
                <label class="text-muted fw-bold">Correo Electrónico:</label>
                <p class="fs-5">@Model.Email</p>
            </div>

            <hr />

            <div class="col-md-4">
                <label class="text-muted fw-bold">Tipo de Usuario:</label>
                <!-- Tipo de Usuario -->
                <p class="fs-5"><span class="badge bg-info text-dark">@Model.TipoUsuario</span></p>
            </div>
            <div class="col-md-4">
                <label class="text-muted fw-bold">Rol en Sistema:</label>
                <p class="fs-5">@Model.RolId</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted fw-bold">Institución:</label>
                <p class="fs-5">@Model.Institucion</p>
            </div>

            <div class="col-md-12 mt-3">
                <label class="text-muted fw-bold">Carrera / Área Asignada:</label>
                <p class="fs-5 text-secondary">@Model.CarreraOArea</p>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- SECCIÓN DEL CÓDIGO QR                      -->
        <!-- ========================================== -->
        <div class="row mt-4 pt-4 border-top">
            <div class="col-12 text-center">
                <h5 class="fw-bold text-secondary mb-3">Código QR de Verificación</h5>

                @if (!string.IsNullOrEmpty(ViewBag.QrCode))
                {
                    <!-- Renderizamos la imagen directamente desde la cadena Base64 -->
                    <img src="data:image/png;base64,@ViewBag.QrCode"
                         alt="Código QR del Usuario"
                         class="img-thumbnail shadow-sm p-2"
                         style="width: 220px; height: 220px;" />

                    <p class="text-muted mt-2 small">Escanea este código para validar el carnet digital.</p>
                }
                else
                {
                    <div class="alert alert-warning d-inline-block">
                        <i class="bi bi-exclamation-triangle"></i> No se pudo generar el código QR.
                    </div>
                }
            </div>
        </div>
        <!-- ========================================== -->

    </div>
    <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-3">
        <a asp-action="WEB16" class="btn btn-secondary">← Volver al Listado</a>

        <div class="d-flex gap-2">
            <!-- BOTÓN NUEVO QUE LLEVA A LA WEB8 -->
            <a asp-action="WEB8" asp-route-id="@Model.Identificacion" class="btn btn-info text-white">
                <i class="bi bi-camera"></i> Gestionar Fotografía
            </a>

            <!-- Botón de editar que ya tenías -->
            <a asp-action="Editar" asp-route-id="@Model.Identificacion" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i> Editar Datos
            </a>
        </div>
    </div>
</div>
