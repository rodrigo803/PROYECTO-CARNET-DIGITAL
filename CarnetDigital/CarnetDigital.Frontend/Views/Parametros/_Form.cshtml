@model CarnetDigital.Frontend.Models.Parametros.ParametroFormViewModel

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <form asp-action="@(Model.EsEdicion ? "Edit" : "Create")" asp-route-id="@(Model.EsEdicion ? Model.Id : null)" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="EsEdicion" />

                    <div class="form-group mb-3">
                        <label asp-for="Id" class="control-label"></label>
                        @if (Model.EsEdicion)
                        {
                            <input asp-for="Id" class="form-control" readonly />
                        }
                        else
                        {
                            <input asp-for="Id" class="form-control" />
                        }
                        <span asp-validation-for="Id" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Valor" class="control-label"></label>
                        <input asp-for="Valor" class="form-control" />
                        <span asp-validation-for="Valor" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
