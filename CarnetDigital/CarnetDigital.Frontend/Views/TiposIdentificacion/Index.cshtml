@model CarnetDigital.Frontend.Models.Shared.PagedResult<CarnetDigital.Frontend.Models.TiposIdentificacion.TipoIdentificacionDto>
@{
    ViewData["Title"] = "Tipos de Identificación";
}

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h4 mb-0">Tipos de Identificación</h1>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Nuevo
            </a>
        </div>

        @if (!Model.Items.Any())
        {
            <p class="text-muted mb-0">No hay tipos de identificación registrados.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Id</th>
                            <th>Nombre</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tipo in Model.Items)
                        {
                            <tr>
                                <td>@tipo.Id</td>
                                <td>@tipo.Nombre</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@tipo.Id" class="btn btn-icon btn-primary" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <button type="button" class="btn btn-icon btn-danger"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                                            data-delete-url="@Url.Action("Delete", new { id = tipo.Id })"
                                            data-nombre="@tipo.Nombre"
                                            title="Eliminar">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Paginación de tipos de identificación" class="mt-3">
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)">Anterior</a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">Página @Model.PageNumber de @Model.TotalPages</span>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteForm" asp-action="Delete" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalTitle">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>¿Realmente desea eliminar el elemento seleccionado?</p>
                    <p class="fw-bold" id="deleteModalNombre"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                    <button type="submit" class="btn btn-danger">Sí</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/confirm-delete.js"></script>
}
