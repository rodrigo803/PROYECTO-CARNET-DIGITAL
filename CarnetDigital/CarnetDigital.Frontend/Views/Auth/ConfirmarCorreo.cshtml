@{
    ViewData["Title"] = "Confirmación de Cuenta";
    bool exito = ViewBag.Exito ?? false;
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow-lg border-0 text-center p-5">
        <div class="card-body">
            @if (exito)
            {
                <div class="mb-4 text-success">
                    <i class="bi bi-check-circle-fill" style="font-size: 5rem;"></i>
                </div>
                <h2 class="fw-bold text-success mb-3">¡Cuenta Confirmada!</h2>
                <p class="lead text-muted mb-4">@ViewBag.Mensaje</p>

                <a asp-action="Login" class="btn btn-primary btn-lg px-5 shadow-sm">
                    Ir a Iniciar Sesión
                </a>
            }
            else
            {
                <div class="mb-4 text-danger">
                    <i class="bi bi-x-circle-fill" style="font-size: 5rem;"></i>
                </div>
                <h2 class="fw-bold text-danger mb-3">No se pudo confirmar</h2>
                <p class="lead text-muted mb-4">@ViewBag.Mensaje</p>

                <a asp-action="Login" class="btn btn-secondary btn-lg px-5 shadow-sm">
                    Volver al Inicio de Sesión
                </a>
            }
        </div>
    </div>
</div>
