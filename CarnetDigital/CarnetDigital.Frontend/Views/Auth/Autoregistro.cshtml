@model CarnetDigital.Frontend.Models.Usuarios.UsuarioDTO

@{
    ViewData["Title"] = "Autoregistro - Carnet Digital";
    // Si tu Login usa un layout específico (como nulo o uno sin menú), ajústalo aquí
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-5">

                    <div class="text-center mb-4">
                        <h1 class="h3 fw-bold mb-1">Crear una Cuenta</h1>
                        <p class="text-muted mb-0">Sistema de Carnet Digital</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <div asp-validation-summary="All" class="mb-0"></div>
                        </div>
                    }

                    <form asp-action="Autoregistro" method="post">

                        <h5 class="text-primary mb-3">Datos Personales</h5>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Identificacion" class="form-label fw-bold">Identificación</label>
                                <input asp-for="Identificacion" class="form-control" required placeholder="Ej. 101110111" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TipoIdentificacionId" class="form-label fw-bold">Tipo de Identificación</label>
                                <select asp-for="TipoIdentificacionId" class="form-select" required>
                                    <option value="">Seleccione...</option>
                                    <option value="1">Cédula Nacional</option>
                                    <option value="2">DIMEX / Residencia</option>
                                    <option value="3">Pasaporte</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NombreCompleto" class="form-label fw-bold">Nombre Completo</label>
                            <input asp-for="NombreCompleto" class="form-control" required placeholder="Ej. Juan Pérez" />
                        </div>

                        <h5 class="text-primary mb-3 mt-4">Credenciales de Acceso</h5>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold">Correo Electrónico</label>
                                <input asp-for="Email" type="email" class="form-control" required placeholder="correo@ejemplo.com" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Contrasena" class="form-label fw-bold">Contraseña</label>
                                <input asp-for="Contrasena" type="password" class="form-control" required placeholder="********" />
                            </div>
                        </div>

                        <h5 class="text-primary mb-3 mt-4">Perfil Institucional</h5>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="TipoUsuarioId" class="form-label fw-bold">¿Qué rol tienes?</label>
                                <select asp-for="TipoUsuarioId" class="form-select" required>
                                    <option value="">Seleccione...</option>
                                    <option value="1">Estudiante</option>
                                    <option value="2">Funcionario</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Institución</label>
                                <select name="InstitucionesIds[0]" class="form-select" required>
                                    <option value="">Seleccione una institución...</option>
                                    @if (ViewBag.Instituciones != null)
                                    {
                                        foreach (var inst in ViewBag.Instituciones)
                                        {
                                            <option value="@inst.Id">@inst.Nombre</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted">Carrera (Si eres estudiante)</label>
                                <select name="CarrerasIds[0]" class="form-select">
                                    <option value="">Ninguna / No aplica</option>
                                    @if (ViewBag.Carreras != null)
                                    {
                                        foreach (var carrera in ViewBag.Carreras)
                                        {
                                            <option value="@carrera.Id">@carrera.Nombre</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted">Área (Si eres funcionario)</label>
                                <select name="AreasIds[0]" class="form-select">
                                    <option value="">Ninguna / No aplica</option>
                                    @if (ViewBag.Areas != null)
                                    {
                                        foreach (var area in ViewBag.Areas)
                                        {
                                            <option value="@area.Id">@area.Nombre</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold">Completar Registro</button>
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-secondary">← Volver al Inicio de Sesión</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
