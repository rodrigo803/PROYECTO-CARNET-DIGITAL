@model CarnetDigital.Frontend.Models.Auth.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">

                    <h1 class="h4 text-center mb-4">
                        Ingreso al Sistema
                    </h1>

                    @if (ViewBag.MensajeExito != null)
                    {
                        <div class="alert alert-success">
                            @ViewBag.MensajeExito
                        </div>
                    }

                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-warning">
                            @ViewBag.Message
                        </div>
                    }

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-action="Login" method="post">

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label">Usuario</label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Contraseña</label>
                            <input asp-for="Password" type="password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TipoUsuario" class="form-label">Tipo de Usuario</label>

                            <select asp-for="TipoUsuario" class="form-select">
                                <option value="">Seleccione</option>
                                <option value="Admin">Administrador</option>
                                <option value="Estudiante">Estudiante</option>
                            </select>

                            <span asp-validation-for="TipoUsuario" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Aceptar
                        </button>

                    </form>

                    <div class="text-center mt-3">
                        <a asp-action="Autoregistro">¿No tenés cuenta? Registrate aquí</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
