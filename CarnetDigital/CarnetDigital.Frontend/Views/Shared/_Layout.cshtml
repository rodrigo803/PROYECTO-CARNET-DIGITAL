@using CarnetDigital.Frontend.Services.Auth
@inject ITokenProvider TokenProvider
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Carnet Digital</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CarnetDigital.Frontend.styles.css" asp-append-version="true" />
</head>
<body>

@if (TokenProvider.IsAuthenticated())
{
    <div class="d-flex">

        <div class="bg-dark text-white p-3" style="width:250px; min-height:100vh;">

            <h4>
                <i class="bi bi-person-badge"></i>
                Carnet Digital
            </h4>

            <hr />

            <ul class="nav flex-column">

                <li class="nav-item">
                    <a asp-controller="Home" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-house"></i>
                        Inicio
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Areas" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-diagram-3"></i>
                        Áreas
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Carreras" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-mortarboard"></i>
                        Carreras
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Instituciones" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-building"></i>
                        Instituciones
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Parametros" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-sliders"></i>
                        Parámetros
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Pantallas" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-window"></i>
                        Pantallas
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Roles" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-person-badge"></i>
                        Roles
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Bitacoras" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-journal-text"></i>
                        Bitácoras
                    </a>
                </li>

                <li class="nav-item mt-3">
                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-link nav-link text-white p-0">
                            <i class="bi bi-box-arrow-right"></i>
                            Cerrar sesión
                        </button>
                    </form>
                </li>

            </ul>

        </div>

        <div class="flex-grow-1">

            <nav class="navbar navbar-light bg-light border-bottom">
                <div class="container-fluid justify-content-end">
                    <i class="bi bi-person-circle fs-3"></i>
                </div>
            </nav>

            <main class="p-4">
                <partial name="_Alert" />
                @RenderBody()
            </main>

        </div>

    </div>
}
else
{
    <div class="container mt-4">
        <partial name="_Alert" />
        @RenderBody()
    </div>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
