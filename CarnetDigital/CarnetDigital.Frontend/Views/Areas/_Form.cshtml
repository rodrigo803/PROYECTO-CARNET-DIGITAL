@model CarnetDigital.Frontend.Models.Areas.AreaFormViewModel

@if (!Model.HayInstitucionesActivas)
{
    <div class="alert alert-warning">
        No hay instituciones activas registradas. Debe existir al menos una institución activa para poder guardar un área de trabajo.
    </div>
    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@(Model.Id == 0 ? null : (int?)Model.Id)" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="form-group mb-3">
                    <label asp-for="Nombre" class="control-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="IdInstitucion" class="control-label"></label>
                    <select asp-for="IdInstitucion" asp-items="Model.Instituciones" class="form-select">
                        <option value="">-- Seleccione una institución --</option>
                    </select>
                    <span asp-validation-for="IdInstitucion" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
}
